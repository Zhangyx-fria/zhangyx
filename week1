# 定义一个计算GC含量的函数
def gc_content(seq):
    length = len(seq)
    if length == 0:
        return 0.0
    g = seq.count('G')
    c = seq.count('C')
    gc = (g + c) / length * 100
    return gc

# 测试函数
dna1 = "ATGC"
dna2 = "GGGGCCCC"
dna3 = "ATATATAT"

print("dna1 GC含量:", gc_content(dna1))
print("dna2 GC含量:", gc_content(dna2))
print("dna3 GC含量:", gc_content(dna3))