# ========= Day5：从NCBI获取真实基因序列 =========
print("Day5: 获取真实基因序列（TP53）")
import requests

def fetch_gene_sequence(gene_id):
    """
    根据NCBI的基因编号（如NM_000546）获取DNA序列字符串
    """
    url = f"https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id={gene_id}&rettype=fasta&retmode=text"
    response = requests.get(url)
    fasta_text = response.text
    lines = fasta_text.strip().split('\n')
    sequence_lines = [line for line in lines if not line.startswith('>')]
    sequence = ''.join(sequence_lines)
    return sequence

# 获取TP53基因（人类抑癌基因）
tp53_seq = fetch_gene_sequence("NM_000546")
print(f"TP53基因序列长度: {len(tp53_seq)} bp")
print("前100个碱基:", tp53_seq[:100])
print(f"TP53基因GC含量: {gc_content(tp53_seq):.2f}%")
