# 定义一个计算GC含量的函数
def gc_content(seq):
    length = len(seq)
    if length == 0:
        return 0.0
    g = seq.count('G')
    c = seq.count('C')
    gc = (g + c) / length * 100
    return gc

# 测试函数
dna1 = "ATGC"
dna2 = "GGGGCCCC"
dna3 = "ATATATAT"

print("dna1 GC含量:", gc_content(dna1))
print("dna2 GC含量:", gc_content(dna2))
print("dna3 GC含量:", gc_content(dna3))

def reverse_complement(seq):
    # 定义互补规则
    comp = {'A':'T', 'T':'A', 'G':'C', 'C':'G'}
    # 生成互补序列
    complement = ''.join(comp[base] for base in seq)
    # 反转
    rev_comp = complement[::-1]
    return rev_comp

test_seq = "ATGC"
print("原序列:", test_seq)
print("反向互补:", reverse_complement(test_seq))