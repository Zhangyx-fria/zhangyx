# ========= Day4：封装为函数 + 扩展反向互补 =========
print("Day4: 函数化工具包")

def gc_content(seq):
    """计算DNA序列的GC含量百分比"""
    length = len(seq)
    if length == 0:
        return 0.0
    g = seq.count('G')
    c = seq.count('C')
    return (g + c) / length * 100

def reverse_complement(seq):
    """返回DNA序列的反向互补序列"""
    comp = {'A':'T', 'T':'A', 'G':'C', 'C':'G'}
    complement = ''.join(comp[base] for base in seq)
    return complement[::-1]

